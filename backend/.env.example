NETRACARE_DATABASE_URL=sqlite:///./netracare.db
NETRACARE_DATA_PACK_PATH=../Project_Resources/data-pack-Iteration_01
NETRACARE_DATA_PACK_2_PATH=../Project_Resources/data-pack-Iteration_02
NETRACARE_CLINIC_TIMEZONE=Asia/Kolkata
# Set only for deterministic tests or demos:
# NETRACARE_CLINIC_NOW=2026-11-02T10:00:00
# Iteration 2 LLM (Google Gemini). Keep secret keys out of git.
NETRACARE_LLM_PROVIDER=gemini
NETRACARE_LLM_MODEL=gemini-3.5-flash-lite
NETRACARE_LLM_TIMEOUT_SECONDS=20
# GOOGLE_API_KEY=your-key-here
# GEMINI_API_KEY works too; either env var is accepted.
# Iteration 3 RAG (Weaviate Cloud). Keep secret keys out of git.
NETRACARE_DATA_PACK_3_PATH=../Project_Resources/data-pack-Iteration_03
NETRACARE_RAG_COLLECTION=NetraCareChunks
NETRACARE_RAG_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5
NETRACARE_RAG_CHUNK_SIZE=1000
NETRACARE_RAG_CHUNK_OVERLAP=100
NETRACARE_RAG_TOP_K=4
# WEAVIATE_URL=your-cluster.weaviate.cloud
# WEAVIATE_API_KEY=your-weaviate-key-here